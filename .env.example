# Copy to .env.<ENV> (default ENV=staging -> .env.staging). Never commit real values.
BASE_URL=https://staging-niramoy.celloscope.net
API_PREFIX=/api/v1/prescription
SWAGGER_FILE=swagger/prescription.json

# Keycloak password grant
AUTH_TOKEN_URL=https://staging-auth-niramoy.celloscope.net/realms/niramoy/protocol/openid-connect/token
AUTH_CLIENT_ID=niramoy-web
AUTH_USERNAME=
AUTH_PASSWORD=

# Real staging IDs. Doctor/patient-scoped tests are skipped while empty.
DOCTOR_ID=
PATIENT_ID=
# Every run creates ONE "[AUTO]" prescription for DOCTOR_ID/PATIENT_ID (prescription lifecycle). The API has no
# single-prescription delete, so it stays; its id is listed in reports/cleanup.md. false = skip the lifecycle.
PRESCRIPTION_WRITES=true

# false = ignore fields the server returns that Swagger does not document
STRICT_CONTRACT=true
REQUEST_TIMEOUT=30000
LOG_REQUESTS=false

# Performance budgets in ms (config/performance.ts). A request over budget is flagged "slow";
# PERF_ENFORCE=true makes it fail functional tests too.
SLA_READ_MS=1500
SLA_WRITE_MS=3000
PERF_ENFORCE=false
# Performance suite (npm run test:perf)
PERF_SAMPLES=10
PERF_CONCURRENCY=10
PERF_LOAD_FACTOR=3
